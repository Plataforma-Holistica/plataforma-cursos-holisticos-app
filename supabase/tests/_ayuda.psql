-- Ayuda común de las pruebas de base. Cada prueba la incluye con \ir dentro de su
-- transacción, así que todo lo de aquí se deshace con el rollback final.
--
-- No es una prueba: por eso no termina en .sql y pg_prove no la corre sola.

create extension if not exists pgtap with schema extensions;

-- Quien corre las pruebas (postgres) creó app_service pero no puede asumirlo sin dárselo.
grant app_service to postgres with set true, inherit false;
-- Las funciones de pgTAP viven en extensions; app_service no lo usa fuera de las pruebas.
grant usage on schema extensions to app_service;

create schema pruebas;
grant usage on schema pruebas to anon, authenticated, app_service;

-- Olvida la sesión y las variables de transacción del paso anterior.
create function pruebas.limpiar() returns void
language sql
as $$
  select set_config('request.jwt.claims', '', true),
         set_config('app.actor_id', '', true),
         set_config('app.actor_kind', '', true),
         set_config('app.actor_session', '', true),
         set_config('app.reason', '', true),
         set_config('app.request_id', '', true),
         set_config('app.legal_drafts', '', true),
         set_config('app.claiming_account', '', true),
         set_config('role', 'none', true);
$$;

-- La sesión y el factor de pruebas de una persona: siempre los mismos, derivados de su
-- identificador.
create function pruebas.sesion(p_id uuid) returns uuid
language sql immutable
as $$ select md5('sesion:' || p_id::text)::uuid $$;

create function pruebas.factor(p_id uuid) returns uuid
language sql immutable
as $$ select md5('factor:' || p_id::text)::uuid $$;

-- Deja a una persona con todo lo que la puerta del equipo pide además de la capacidad
-- (T-105): la cuenta reclamada, un factor verificado y atado a ella, y su sesión de pruebas
-- anotada por la aplicación y en segundo nivel con ese factor, verificada ahora. Lo deja el
-- dueño, como lo dejarían Supabase Auth y la aceptación de una invitación. Se puede llamar
-- más de una vez.
create function pruebas.equipar(p_id uuid) returns void
language plpgsql
as $$
begin
  perform pruebas.limpiar();
  perform set_config('app.claiming_account', 'on', true);
  update public.profiles set password_reset_required = false where id = p_id;
  perform set_config('app.claiming_account', '', true);
  insert into auth.mfa_factors (id, user_id, friendly_name, factor_type, status, created_at, updated_at, secret)
  values (pruebas.factor(p_id), p_id, 'equipo', 'totp', 'verified', now(), now(), 'JBSWY3DPEHPK3PXP')
  on conflict (id) do update set status = 'verified';
  insert into auth.sessions (id, user_id, aal, factor_id, created_at, updated_at)
  values (pruebas.sesion(p_id), p_id, 'aal2', pruebas.factor(p_id), now(), now())
  on conflict (id) do update set aal = 'aal2', factor_id = excluded.factor_id, not_after = null;
  insert into auth.mfa_amr_claims (id, session_id, authentication_method, created_at, updated_at)
  values (md5('verificacion:' || p_id::text)::uuid, pruebas.sesion(p_id), 'totp', now(), now())
  on conflict (id) do update set updated_at = now();
  insert into private.app_sessions (session_id, profile_id) values (pruebas.sesion(p_id), p_id)
  on conflict (session_id) do nothing;
  -- Atar un factor queda en la auditoría, y aquí no hay persona que lo haga.
  perform set_config('app.actor_kind', 'system', true);
  insert into private.admin_factors (profile_id, factor_id, bound_email)
  values (p_id, pruebas.factor(p_id), (select lower(u.email) from auth.users u where u.id = p_id))
  on conflict (profile_id) do nothing;
  perform set_config('app.actor_kind', '', true);
end
$$;

-- Baja la sesión de pruebas de una persona a primer nivel, como queda en Auth la de quien
-- entró con su contraseña y no ha dado su código. Si no tiene sesión de pruebas, no hace nada.
create function pruebas.sin_codigo(p_id uuid) returns void
language plpgsql
as $$
begin
  perform pruebas.limpiar();
  update auth.sessions set aal = 'aal1', factor_id = null where id = pruebas.sesion(p_id);
  delete from auth.mfa_amr_claims where session_id = pruebas.sesion(p_id);
end
$$;

-- Camino del usuario: una persona con sesión. aal2 es «con segundo factor», y desde T-105
-- eso no lo dice el token: la base lo lee de la sesión. Por eso con aal2 la persona queda
-- equipada de verdad, y con aal1 su sesión de pruebas baja a primer nivel.
create function pruebas.como_usuario(p_id uuid, p_aal text default 'aal1') returns void
language plpgsql
as $$
begin
  if p_aal = 'aal2' then
    perform pruebas.equipar(p_id);
  else
    perform pruebas.sin_codigo(p_id);
  end if;
  perform pruebas.limpiar();
  perform set_config('request.jwt.claims',
            json_build_object('sub', p_id, 'role', 'authenticated', 'aal', p_aal,
                              'session_id', pruebas.sesion(p_id))::text, true),
          set_config('role', 'authenticated', true);
end
$$;

-- Visitante: sin sesión.
create function pruebas.como_visitante() returns void
language sql
as $$
  select pruebas.limpiar();
  select set_config('request.jwt.claims', '{"role":"anon"}', true),
         set_config('role', 'anon', true);
$$;

-- Camino de servicio: el servidor, que declara en la transacción por quién actúa y con qué
-- sesión. El nivel no se declara: la base lo lee de la sesión, igual que en el otro camino.
-- Por omisión quien tiene o tuvo una capacidad queda equipado, que es como actúa de verdad
-- alguien del equipo; a las demás cuentas no se les toca nada, porque casi todas las pruebas
-- que pasan por aquí son de cuentas comunes y miran su marca y sus sesiones.
create function pruebas.como_servicio(p_actor uuid default null, p_aal text default 'aal2') returns void
language plpgsql
as $$
begin
  perform pruebas.limpiar();
  if p_actor is not null and p_aal <> 'aal2' then
    perform pruebas.sin_codigo(p_actor);
  elsif exists (select 1 from public.admin_capabilities c where c.profile_id = p_actor) then
    perform pruebas.equipar(p_actor);
  end if;
  perform pruebas.limpiar();
  perform set_config('app.actor_id', coalesce(p_actor::text, ''), true),
          set_config('app.actor_session', coalesce(pruebas.sesion(p_actor)::text, ''), true),
          set_config('role', 'app_service', true);
end
$$;

-- Un trabajo del sistema, por el camino de servicio.
create function pruebas.como_sistema() returns void
language sql
as $$
  select pruebas.limpiar();
  select set_config('app.actor_kind', 'system', true),
         set_config('role', 'app_service', true);
$$;

-- El dueño de las tablas (el rol de las migraciones), sin autor declarado.
create function pruebas.como_dueno() returns void
language sql
as $$ select pruebas.limpiar(); $$;

-- Alta de una cuenta, como la haría Supabase Auth.
create function pruebas.alta(p_id uuid, p_email text) returns void
language sql
as $$ insert into auth.users (id, email) values (p_id, p_email); $$;

-- Confirma el correo de una cuenta, como lo hace Supabase Auth al canjear el enlace.
create function pruebas.confirmar(p_id uuid) returns void
language sql
as $$ update auth.users set email_confirmed_at = now() where id = p_id; $$;

-- Da una capacidad escribiendo la tabla, como dueño declarado sistema: el servidor ya no
-- puede (T-105). Es un atajo de las pruebas: de verdad una capacidad solo se recibe
-- aceptando una invitación o de quien tiene configuración (13_invitaciones).
create function pruebas.dar_capacidad(p_profile uuid, p_capability text) returns void
language plpgsql
as $$
begin
  perform pruebas.limpiar();
  perform set_config('app.actor_kind', 'system', true);
  execute format(
    'insert into public.admin_capabilities (profile_id, capability) values (%L, %L)',
    p_profile, p_capability);
  perform pruebas.limpiar();
end
$$;

grant execute on all functions in schema pruebas to anon, authenticated, app_service;
