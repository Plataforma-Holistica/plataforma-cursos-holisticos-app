-- Para las pruebas de liberar que no tratan de impuestos (T-409): una regla en 0, y todo maestro nace con sus datos fiscales. Con eso las cifras de esas pruebas
-- siguen siendo las del PRD: una regla en 0 las conserva. Lo que hacen las retenciones se prueba en `64_retenciones`. Va después de `_ayuda.psql`, y como todo
-- en una prueba de base, se revierte al terminar.
insert into public.withholding_rules (tax_regime_code, payee_kind, vat_rate, income_tax_withholding_rate, vat_withholding_rate, effective_from, note)
values ('612', 'person', 0, 0, 0, '2000-01-01', 'regla en 0 de las pruebas');

create function pruebas.datos_fiscales_al_nacer() returns trigger language plpgsql security definer as $$
begin
  insert into private.teacher_tax_profiles (teacher_id, version, rfc_enc, legal_name_enc, tax_regime_code, payee_kind, clabe_enc, clabe_last4, key_version)
  select new.id, 1, x.sealed13, x.sealed20, '612', 'person', x.sealed18, '7771', 1
  from (select decode('010001' || repeat('ab', 12 + 13 + 16), 'hex') as sealed13,
               decode('010001' || repeat('ab', 12 + 20 + 16), 'hex') as sealed20,
               decode('010001' || repeat('ab', 12 + 18 + 16), 'hex') as sealed18) x;
  return null;
end
$$;
create trigger pruebas_datos_fiscales after insert on public.teachers
  for each row execute function pruebas.datos_fiscales_al_nacer();
