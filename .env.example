# Variables de entorno de la Plataforma (TRD §11.4). Solo nombres: aquí nunca va un valor
# real. Copia este archivo a `.env.local` y llénalo.
#
# La aplicación valida todas al arrancar y se niega a iniciar si falta una
# (src/config/env.ts). Cada tarea que integra un proveedor agrega aquí las suyas.
#
# Las que empiezan con NEXT_PUBLIC_ llegan al navegador y no son secretas.

# Aplicación. APP_ENV es local, staging o production.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. En local, los valores salen de `pnpm db:status`:
#   NEXT_PUBLIC_SUPABASE_URL              API URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  Publishable key
#   SUPABASE_SECRET_KEY                   Secret key
#   DATABASE_URL_DIRECT                   Database URL, tal cual. Entra como postgres y
#                                         solo sirve para migraciones y para db:login.
#   DATABASE_URL                          La misma, cambiando el usuario por app_service y
#                                         la contraseña por una que inventes, de 12
#                                         caracteres o más. Es la que usa la aplicación
#                                         (TRD §8.10).
# Después corre `pnpm db:login`: le da a app_service esa entrada en la base local.
# `pnpm db:reset` lo repite solo, porque rehacer la base borra los roles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_URL_DIRECT=

# Fuera de local los valores no van en un archivo: se cargan en el proyecto de Vercel
# (Settings > Environment Variables), los de staging en Preview y los reales en
# Production. En el panel de Supabase salen de:
#   NEXT_PUBLIC_SUPABASE_URL              Project Settings > Data API > Project URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  Project Settings > API Keys > Publishable key
#   SUPABASE_SECRET_KEY                   Project Settings > API Keys > Secret key
#   DATABASE_URL_DIRECT                   Connect > Direct connection. Entra como postgres,
#                                         solo para migraciones.
#   DATABASE_URL                          Connect > Transaction pooler (puerto 6543), pero
#                                         no con el usuario postgres que muestra el panel:
#                                         el usuario es app_service.<ref del proyecto> y la
#                                         contraseña es la del rol app_service, que se le
#                                         pone aparte en cada entorno y no pasa por el
#                                         repositorio. Sin ningún parámetro (nada después
#                                         de un `?`): la aplicación verifica el certificado
#                                         por su cuenta y rechaza una cadena que traiga
#                                         alguno, porque podría cambiar a quién se entra.
# Y con ellos: APP_ENV=staging y NEXT_PUBLIC_SITE_URL con la dirección del despliegue.

# Sentry, el registro de errores (RNF-16).
#   SENTRY_DSN  A dónde se mandan los errores. Sale de Project Settings > Client Keys
#               (DSN). No es secreta: también llega al navegador.
#               En local se deja vacía, y entonces no se manda nada. La dirección real no
#               se pone en local: cada prueba le llegaría al proyecto de Sentry como un
#               error más. Para ver qué saldría desde tu máquina, usa en esa corrida una
#               dirección falsa que apunte a ella misma y mira las peticiones en el
#               navegador: `SENTRY_DSN=http://0123456789abcdef@127.0.0.1:9/1 pnpm dev`.
#               Fuera de local es obligatoria, cifrada y con la forma que el SDK acepta:
#               la aplicación se niega a iniciar sin ella.
SENTRY_DSN=

# La llave para subir los mapas de código a Sentry (SENTRY_AUTH_TOKEN) no va aquí ni en
# .env.local: solo se usa al compilar en Vercel, y ahí vive (Settings > Environment
# Variables, marcada como Sensitive). Sale de Settings > Developer Settings >
# Organization Tokens. Una compilación en local no sube nada aunque la encuentre.
#
# SENTRY_TRACES_SAMPLE_RATE no se admite, ni aquí ni en Vercel: la aplicación se niega a
# iniciar si la encuentra. El SDK la lee por su cuenta y con ella prende las trazas, que
# son otra recolección. A Sentry solo salen errores (TRD §10.5).

# ---------------------------------------------------------------------------------------
# Las que siguen. La aplicación todavía no las lee ni las valida: cada una entra a
# src/config/env.ts con la tarea que integra a su proveedor. Están aquí para saber qué
# llaves hay que ir consiguiendo.
# ---------------------------------------------------------------------------------------

# Resend, correo transaccional (T-104 fuera de local; en local el correo cae en el buzón
# de Supabase, http://127.0.0.1:54324). Necesita el dominio verificado en Resend.
#   RESEND_API_KEY         API Keys, con permiso de solo envío.
#   RESEND_WEBHOOK_SECRET  Webhooks > Signing secret. Existe hasta que se dé de alta el
#                          aviso de rebotes.
#   MAIL_FROM_ACCOUNT      Remitente de los correos de la cuenta (verificar, recuperar).
#   MAIL_FROM_NOTICES      Remitente de los avisos.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM_ACCOUNT=
MAIL_FROM_NOTICES=
