# Variables de entorno de la Plataforma (TRD §11.4). Solo nombres: aquí nunca va un valor
# real. Copia este archivo a `.env.local` y llénalo.
#
# La aplicación valida todas al arrancar y se niega a iniciar si falta una
# (src/config/env.ts). Cada tarea que integra un proveedor agrega aquí las suyas.
#
# Las que empiezan con NEXT_PUBLIC_ llegan al navegador y no son secretas.

# Aplicación. APP_ENV es local, staging o production.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. En local, los valores salen de `pnpm db:status`:
#   NEXT_PUBLIC_SUPABASE_URL              API URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  Publishable key
#   SUPABASE_SECRET_KEY                   Secret key
#   DATABASE_URL y DATABASE_URL_DIRECT    Database URL (en local es la misma)
# Fuera de local, DATABASE_URL va por el concentrador de conexiones y
# DATABASE_URL_DIRECT es la directa, solo para migraciones.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_URL_DIRECT=

# Fuera de local los valores no van en un archivo: se cargan en el proyecto de Vercel
# (Settings > Environment Variables), los de staging en Preview y los reales en
# Production. En el panel de Supabase salen de:
#   NEXT_PUBLIC_SUPABASE_URL              Project Settings > Data API > Project URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  Project Settings > API Keys > Publishable key
#   SUPABASE_SECRET_KEY                   Project Settings > API Keys > Secret key
#   DATABASE_URL                          Connect > Transaction pooler
#   DATABASE_URL_DIRECT                   Connect > Direct connection
# Y con ellos: APP_ENV=staging y NEXT_PUBLIC_SITE_URL con la dirección del despliegue.

# ---------------------------------------------------------------------------------------
# Las que siguen. La aplicación todavía no las lee ni las valida: cada una entra a
# src/config/env.ts con la tarea que integra a su proveedor. Están aquí para saber qué
# llaves hay que ir consiguiendo.
# ---------------------------------------------------------------------------------------

# Sentry, registro de errores con alerta (lo que falta de T-102).
#   SENTRY_DSN         Project Settings > Client Keys (DSN). Va en local y en Vercel.
#   SENTRY_AUTH_TOKEN  Settings > Auth Tokens, con permiso de subir mapas de código.
#                      Solo va como secreto de GitHub Actions, nunca en .env.local.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Resend, correo transaccional (T-104 fuera de local; en local el correo cae en el buzón
# de Supabase, http://127.0.0.1:54324). Necesita el dominio verificado en Resend.
#   RESEND_API_KEY         API Keys, con permiso de solo envío.
#   RESEND_WEBHOOK_SECRET  Webhooks > Signing secret. Existe hasta que se dé de alta el
#                          aviso de rebotes.
#   MAIL_FROM_ACCOUNT      Remitente de los correos de la cuenta (verificar, recuperar).
#   MAIL_FROM_NOTICES      Remitente de los avisos.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
MAIL_FROM_ACCOUNT=
MAIL_FROM_NOTICES=
