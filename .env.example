# Variables de entorno de la Plataforma (TRD §11.4). Solo nombres: aquí nunca va un valor
# real. Copia este archivo a `.env.local` y llénalo.
#
# La aplicación valida todas al arrancar y se niega a iniciar si falta una
# (src/config/env.ts). Cada tarea que integra un proveedor agrega aquí las suyas.
#
# Las que empiezan con NEXT_PUBLIC_ llegan al navegador y no son secretas.

# Aplicación. APP_ENV es local, staging o production.
APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. En local, los valores salen de `pnpm db:status`:
#   NEXT_PUBLIC_SUPABASE_URL              API URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  Publishable key
#   SUPABASE_SECRET_KEY                   Secret key
#   DATABASE_URL y DATABASE_URL_DIRECT    Database URL (en local es la misma)
# Fuera de local, DATABASE_URL va por el concentrador de conexiones y
# DATABASE_URL_DIRECT es la directa, solo para migraciones.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
DATABASE_URL_DIRECT=
