{
  "name": "plataforma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/db-turno.mjs exigir --base=aviso && next dev -p 3000",
    "build": "next build",
    "start": "node scripts/db-turno.mjs exigir --base=aviso && next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit --project ui",
    "test:coverage": "vitest run --project unit --coverage",
    "test:int": "node scripts/db-turno.mjs exigir --base && vitest run --project integration",
    "test:e2e": "node scripts/db-turno.mjs exigir --base && playwright test",
    "test:e2e:equipo": "node scripts/db-turno.mjs exigir --base && node scripts/e2e-equipo.mjs",
    "test:escala": "node scripts/db-turno.mjs exigir --base && node scripts/test-escala.mjs",
    "secrets": "secretlint \"**/*\"",
    "db:start": "node scripts/db-turno.mjs exigir && supabase start",
    "db:stop": "node scripts/db-turno.mjs exigir && supabase stop",
    "db:status": "supabase status",
    "db:reset": "node scripts/db-turno.mjs exigir && supabase db reset && node scripts/db-app-login.mjs && node scripts/db-legal-drafts.mjs",
    "db:login": "node scripts/db-turno.mjs exigir && node scripts/db-app-login.mjs",
    "db:drafts": "node scripts/db-turno.mjs exigir && node scripts/db-legal-drafts.mjs",
    "db:admins": "node scripts/db-turno.mjs exigir --base && node scripts/db-admins.mjs",
    "db:courses": "node scripts/db-turno.mjs exigir --base && node scripts/db-test-courses.mjs",
    "db:student": "node scripts/db-turno.mjs exigir --base && node scripts/db-student.mjs",
    "db:rollup": "node scripts/db-turno.mjs exigir --base && node scripts/db-rollup.mjs",
    "storage:repaso": "node scripts/db-turno.mjs exigir --base && node scripts/storage-repaso.mjs",
    "media:upload-test": "node scripts/media-upload-test.mjs",
    "media:check": "node scripts/media-check.mjs",
    "media:captions-test": "node scripts/media-captions-test.mjs",
    "team:handoff": "node scripts/team-handoff.mjs",
    "db:migration": "supabase migration new",
    "db:orden": "git fetch -q origin main && node scripts/migraciones-en-orden.mjs origin/main HEAD",
    "test:db": "node scripts/db-turno.mjs exigir --base && supabase test db",
    "db:turno": "node scripts/db-turno.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ],
    "onlyBuiltDependencies": [
      "supabase"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "handlebars": "4.7.10"
    }
  },
  "dependencies": {
    "@mux/mux-player-react": "3.14.0",
    "@sentry/nextjs": "11.5.0",
    "@supabase/supabase-js": "2.117.3",
    "lucide": "1.52.0",
    "media-chrome": "4.19.3",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "fast-check": "4.10.2",
    "jsdom": "29.1.1",
    "secretlint": "13.0.7",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
