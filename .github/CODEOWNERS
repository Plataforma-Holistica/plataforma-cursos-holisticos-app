# Las tres zonas que se escriben despacio (TRD §2 y §12.2). Un cambio en estas rutas no se
# fusiona sin que una persona lo lea línea por línea. Las rutas de servicios y adaptadores
# de cada zona se agregan cuando su tarea las crea.
#
# GitHub lo hace cumplir: `main` exige la aprobación de un dueño cuando una solicitud toca
# una de estas rutas. Quien abre la solicitud no puede aprobarla, así que hay dos dueños,
# las dos cuentas de Sergio: aprueba la que no la abrió. Una solicitud que no toca estas
# rutas entra con la integración continua en verde.

# Control de acceso
/src/domain/access/        @SerchFGA @plataformaholisticadev
# Los servicios de cuenta: la guarda de sesión aplicada, entrar y salir
/src/services/account/     @SerchFGA @plataformaholisticadev
# Las prácticas y los niveles del catálogo: quién los cambia (Contenido, con código reciente)
/src/services/catalog/     @SerchFGA @plataformaholisticadev
/src/services/media/       @SerchFGA @plataformaholisticadev
/src/services/review/      @SerchFGA @plataformaholisticadev
# El paso previo de cada petición: renueva la sesión y manda a entrar a quien no la trae.
# No decide quién pasa
/src/proxy.ts              @SerchFGA @plataformaholisticadev
# La puerta de las pantallas: el lector único de la petición, la guarda de cada página, las
# acciones de servidor de la cuenta y la ruta que cierra una sesión rechazada
/src/app/_lib/             @SerchFGA @plataformaholisticadev
/src/app/(cuenta)/         @SerchFGA @plataformaholisticadev
/src/app/sesion/           @SerchFGA @plataformaholisticadev
/src/app/inicio/           @SerchFGA @plataformaholisticadev
# Administración: toda página bajo esta ruta corre la guarda del equipo, y el comodín hace
# que una ruta que existe y una que no existe le contesten lo mismo a quien no es del equipo
/src/app/admin/            @SerchFGA @plataformaholisticadev
/src/app/_video/           @SerchFGA @plataformaholisticadev
/src/app/cursos/           @SerchFGA @plataformaholisticadev
/src/services/lessons/     @SerchFGA @plataformaholisticadev
# El progreso de cada cuenta (T-206): lo que se lee de lo que vio
/src/services/progress/    @SerchFGA @plataformaholisticadev
/src/domain/progress/      @SerchFGA @plataformaholisticadev
# Las alertas de anomalía y las decisiones de finanzas (T-208): excluir del reparto, decidir fraude
/src/services/anomalies/   @SerchFGA @plataformaholisticadev
# La medición de la cabecera de la dirección, de la que dependen el freno y los topes
/src/app/api/origin-drill/ @SerchFGA @plataformaholisticadev
# Los textos de las pantallas de la cuenta: entre ellos, la frase que la persona acepta
/src/messages/es/account.ts @SerchFGA @plataformaholisticadev
# Los textos de administración: lo que una confirmación dice que va a pasar al cambiar el equipo
/src/messages/es/admin.ts  @SerchFGA @plataformaholisticadev
# Los textos legales que la gente lee antes de aceptar
/src/app/legal/            @SerchFGA @plataformaholisticadev
/src/services/legal/       @SerchFGA @plataformaholisticadev
# Las cabeceras de las páginas con enlace de correo
/next.config.ts            @SerchFGA @plataformaholisticadev
# La configuración de Auth y sus correos: confirmación, vigencias, contraseña mínima
/supabase/config.toml      @SerchFGA @plataformaholisticadev
/supabase/templates/       @SerchFGA @plataformaholisticadev
# El único camino del código a la base: decide por quién se actúa (ADR-31)
/src/adapters/supabase/    @SerchFGA @plataformaholisticadev
/src/adapters/mux/         @SerchFGA @plataformaholisticadev

# Medición y reparto
/src/domain/consumption/   @SerchFGA @plataformaholisticadev
/src/domain/payout/        @SerchFGA @plataformaholisticadev

# Toda migración del esquema propio: puede tocar un libro
/supabase/migrations/      @SerchFGA @plataformaholisticadev

# Las pruebas de base, que dicen qué se le niega a cada rol, y la semilla de parámetros
/supabase/tests/           @SerchFGA @plataformaholisticadev
/supabase/seeds/           @SerchFGA @plataformaholisticadev
# Los textos legales de borrador, que solo se cargan en una base local
/supabase/local/           @SerchFGA @plataformaholisticadev

# Lo que sale hacia un tercero: qué recolecta el registro de errores y el filtro de datos
# personales por el que pasa cada error (TRD §10.5)
/src/adapters/sentry/      @SerchFGA @plataformaholisticadev

# Las reglas de capas y la integración continua, que protegen todo lo anterior
/eslint.config.mjs         @SerchFGA @plataformaholisticadev
/.github/                  @SerchFGA @plataformaholisticadev

# Las pruebas que hacen cumplir esas reglas, y los guiones que tocan roles de la base
/tests/architecture/       @SerchFGA @plataformaholisticadev
/tests/integration/        @SerchFGA @plataformaholisticadev
/tests/proxy/              @SerchFGA @plataformaholisticadev
/tests/actions/            @SerchFGA @plataformaholisticadev
# El extremo a extremo: entra a la base local como dueño y usa la llave secreta de Auth
/tests/e2e/                @SerchFGA @plataformaholisticadev
/playwright.config.ts      @SerchFGA @plataformaholisticadev
/vitest.config.ts          @SerchFGA @plataformaholisticadev
/tests/scripts/            @SerchFGA @plataformaholisticadev
/scripts/                  @SerchFGA @plataformaholisticadev
